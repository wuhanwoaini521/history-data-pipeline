{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://history-data-pipeline.local/schemas/period.schema.json",
  "title": "Period",
  "description": "历史浏览与组织单位。Period 不等于具体政权；早期年代仅作 approximate。",
  "type": "object",
  "required": ["id", "name_zh_cn", "start_year", "end_year", "date_precision", "description_zh_cn"],
  "properties": {
    "id": { "type": "string", "pattern": "^period-[a-z0-9-]+$" },
    "name_zh_cn": { "type": "string", "minLength": 1 },
    "name_raw": { "type": ["string", "null"] },
    "start_year": { "type": ["integer", "null"], "description": "公元前用负整数，如 -221" },
    "end_year": { "type": ["integer", "null"] },
    "date_precision": { "enum": ["exact", "year", "range", "approximate", "before", "after", "unknown"] },
    "description_zh_cn": { "type": "string" },
    "quality_status": { "type": "string", "default": "reviewed" },
    "source_type": { "type": "string", "default": "curated_reference" },
    "source_reference": { "type": ["string", "null"] },
    "source_ids": { "type": ["array", "null"], "items": { "type": "string" } }
  },
  "additionalProperties": false
}