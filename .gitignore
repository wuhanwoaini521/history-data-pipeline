.venv/
.venv-batch02/
**/__pycache__/
.pytest_cache/
*.pyc
*.egg-info/

# Layer 1：Raw / Staging 不入 Git（大数据集通过 manifest + download script 重建）
data/raw/
data/staging/

# Legacy 构建产物（Layer 4 现在是 dist/）
data/normalized/
data/exports/
data/reports/
data/logs/

# Layer 4：Build Artifact（不可手动编辑；由 history-data backbone build 生成）
dist/
!dist/.gitkeep

# 生成型零散产物
*.part
reports/*.tmp

# 发现阶段候选评分产物（一次性中间态；源 YAML 在 data/candidates/backbone_events，可确定性重建）
reports/current-run-candidates/